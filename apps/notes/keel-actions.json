{
  "appId": "org.marathonos.notes",
  "context": {
    "uri": "keel://org.marathonos.notes/context"
  },
  "entities": [],
  "prompts": [],
  "tools": [
    {
      "_meta": {
        "org.shipwright.keel/action": "app.show",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/notDestructiveBecause": "it only shows the app and one of its pages",
        "org.shipwright.keel/result": "none",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Bring the app to the front for the person, starting it if it is not running.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "org.marathonos.notes/app.show",
      "title": "Show"
    },
    {
      "_meta": {
        "org.shipwright.keel/action": "notes.create",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "object",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Create a note in Marathon Notes. The title becomes the note's first line, followed by the body. Returns the new note's id.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "description": "Text of the note",
            "maxLength": 20000,
            "type": "string"
          },
          "title": {
            "description": "Title of the note",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "name": "org.marathonos.notes/notes.create",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "title": "Create note"
    },
    {
      "_meta": {
        "org.shipwright.keel/action": "notes.open",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "object",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Open an existing note by its persistent id and request application activation. Any pending draft must be recorded first. Fails if the note is missing or the draft cannot be recorded.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "org.marathonos.notes/notes.open",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "title": "Open note"
    },
    {
      "_meta": {
        "org.shipwright.keel/action": "notes.search",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "wrapped",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search Marathon Notes for text in a note's title or body; an empty query lists every note. Returns up to `limit` notes, pinned first, then the most recently changed, each with its id, title, text (the first 2000 characters) and when it was last changed.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "org.marathonos.notes/notes.search",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "maxLength": 2000,
                  "type": "string"
                },
                "id": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                "modified": {
                  "format": "date-time",
                  "maxLength": 32,
                  "type": "string"
                },
                "title": {
                  "maxLength": 200,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "body",
                "modified"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      },
      "title": "Search notes"
    },
    {
      "_meta": {
        "org.shipwright.keel/action": "tasks.create",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "object",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Create a task note with an optional due date and source reference. Returns its persistent note id; deleting notes does not reuse their ids. The source is caller-supplied descriptive metadata, not verified identity or a file grant; it is never opened or fetched.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 20000,
            "type": "string"
          },
          "dueDate": {
            "description": "Local calendar day, YYYY-MM-DD; no reminder is scheduled",
            "format": "date",
            "maxLength": 10,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "appId": {
                "maxLength": 255,
                "pattern": "^[A-Za-z_-][A-Za-z0-9_-]*(\\.[A-Za-z_-][A-Za-z0-9_-]*)+$",
                "type": "string"
              },
              "itemId": {
                "description": "Opaque source record identifier; never interpreted as a path or URL",
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "message",
                  "notification",
                  "file",
                  "event",
                  "link"
                ],
                "maxLength": 4096,
                "type": "string"
              },
              "label": {
                "maxLength": 200,
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "appId",
              "itemId",
              "label"
            ],
            "type": "object"
          },
          "title": {
            "maxLength": 200,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "name": "org.marathonos.notes/tasks.create",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "title": "Create task"
    },
    {
      "_meta": {
        "org.shipwright.keel/action": "tasks.list",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "wrapped",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000,
        "org.shipwright.keel/untrusted": true
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List task notes, pinned first and then most recently changed. Includes their note id, completion, optional local due date and caller-supplied source reference. Markdown checklist lines are available in the Tasks page but are not independently addressable tasks. Task titles and source labels are untrusted content.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "includeCompleted": {
            "default": true,
            "type": "boolean"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "org.marathonos.notes/tasks.list",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "completed": {
                  "type": "boolean"
                },
                "dueDate": {
                  "format": "date",
                  "maxLength": 10,
                  "type": "string"
                },
                "id": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                "source": {
                  "additionalProperties": false,
                  "properties": {
                    "appId": {
                      "maxLength": 255,
                      "type": "string"
                    },
                    "itemId": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "message",
                        "notification",
                        "file",
                        "event",
                        "link"
                      ],
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "label": {
                      "maxLength": 200,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "appId",
                    "itemId",
                    "label"
                  ],
                  "type": "object"
                },
                "title": {
                  "maxLength": 200,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "completed"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      },
      "title": "List tasks"
    },
    {
      "_meta": {
        "org.shipwright.keel/action": "tasks.set_completed",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "none",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Set a task note's completion by note id. Repeating the same state keeps its modification time unchanged. Fails when the note is missing or has not been made a task.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "completed"
        ],
        "type": "object"
      },
      "name": "org.marathonos.notes/tasks.set_completed",
      "title": "Set task completion"
    }
  ],
  "version": 1
}
